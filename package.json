{
  "name": "congress-receipts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Congress Receipts: automated daily YouTube Shorts on members of Congress' stock trades, from official disclosure filings.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "daily": "tsx src/cli.ts daily",
    "dry-run": "tsx src/cli.ts daily --dry-run",
    "fetch": "tsx src/cli.ts fetch",
    "site": "tsx src/cli.ts site",
    "learn": "tsx src/cli.ts learn",
    "health": "tsx src/cli.ts health",
    "studio": "remotion studio remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.538",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
