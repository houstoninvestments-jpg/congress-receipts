# Names only. Real values go in GitHub Actions secrets (Settings > Secrets and variables > Actions).
# Never commit a filled-in copy of this file.

# Writer and checker models
ANTHROPIC_API_KEY=

# Prices: a Marketstack COMMERCIAL plan key (the free plan is non-commercial; don't use it here)
MARKETSTACK_API_KEY=

# This channel's own Google Cloud OAuth client (never Scam or Not's)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Website on Cloudflare Pages (the same Pages-only token Scam or Not uses). Account ID is optional.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
